@model BanSach.Models.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="card auth-card login-card shadow-sm">
    <div class="card-body p-4 p-md-5">
        <div class="login-logo text-center mb-4">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="login-logo-link">
                <img src="~/images/logo.svg" alt="BanSach" class="login-logo-img" />
                <span class="login-logo-text">BanSach</span>
            </a>
            <p class="login-subtitle mb-0">Đăng nhập để tiếp tục mua sắm</p>
        </div>

        <form asp-action="DangNhap" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập hoặc email"
                           autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <a asp-action="QuenMatKhau" class="small">Quên mật khẩu?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu"
                           autocomplete="current-password" id="MatKhau" />
                    <button class="btn btn-outline-secondary" type="button" id="toggleMatKhau"
                            aria-label="Hiện mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-login w-100 mt-2">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
            </button>
        </form>

        <p class="text-center mt-4 mb-0">
            Chưa có tài khoản? <a asp-action="DangKy" class="fw-semibold">Đăng ký ngay</a>
        </p>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('toggleMatKhau').addEventListener('click', function () {
            var input = document.getElementById('MatKhau');
            var hien = input.type === 'password';
            input.type = hien ? 'text' : 'password';
            this.querySelector('i').className = hien ? 'bi bi-eye-slash' : 'bi bi-eye';
            this.setAttribute('aria-label', hien ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
        });
    </script>
}
