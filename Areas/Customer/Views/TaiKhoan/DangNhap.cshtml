@model BanSach.Models.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="card auth-card shadow-sm">
    <div class="card-body p-4">
        <h2 class="fw-bold mb-3">Đăng nhập</h2>
        <form asp-action="DangNhap" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <input asp-for="TenDangNhap" class="form-control" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label"></label>
                <input asp-for="MatKhau" class="form-control" />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>
            <button class="btn btn-dark w-100">Đăng nhập</button>
        </form>
        <div class="d-flex justify-content-between mt-3">
            <a asp-action="DangKy">Đăng ký</a>
            <a asp-action="QuenMatKhau">Quên mật khẩu?</a>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
