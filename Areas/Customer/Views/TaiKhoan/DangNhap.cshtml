@model BanSach.Models.ViewModels.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .auth-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 0;
    }

    .auth-card {
        width: 100%;
        max-width: 430px;
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        background: #fff;
    }

    .auth-header {
        background: linear-gradient(135deg, #111827, #1f2937);
        color: #fff;
        padding: 28px 24px;
        text-align: center;
    }

    .auth-header p {
        color: rgba(255, 255, 255, 0.72);
        margin-bottom: 0;
    }

    .auth-body {
        padding: 28px;
    }

    .auth-label {
        font-weight: 600;
        color: #111827;
    }

    .auth-input {
        border-radius: 10px;
        border: 1px solid #d1d5db;
        padding: 12px 14px;
        font-size: 15px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .auth-input:focus {
        border-color: #111827;
        box-shadow: 0 0 0 .2rem rgba(17, 24, 39, .08);
    }

    .auth-btn {
        border-radius: 10px;
        padding: 12px 16px;
        font-weight: 700;
        background: #111827;
        border: 1px solid #111827;
        transition: all .15s ease;
    }

    .auth-btn:hover {
        background: #000;
        transform: translateY(-1px);
    }

    .auth-link {
        font-weight: 600;
        color: #111827;
        text-decoration: none;
    }

    .auth-link:hover {
        text-decoration: underline;
    }

    .auth-validation ul {
        margin-bottom: 0;
        padding-left: 18px;
    }
</style>

<div class="auth-page">
    <div class="card auth-card shadow-lg">
        <div class="auth-header">
            <h2 class="fw-bold mb-1">Đăng nhập</h2>
            <p>Chào mừng bạn quay lại hệ thống</p>
        </div>

        <div class="card-body auth-body">
            <form asp-action="DangNhap" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger small auth-validation mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label auth-label"></label>
                    <input asp-for="TenDangNhap"
                           class="form-control auth-input"
                           autocomplete="username"
                           placeholder="Nhập tên đăng nhập" />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label auth-label"></label>
                    <input asp-for="MatKhau"
                           type="password"
                           class="form-control auth-input"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 auth-btn">
                    Đăng nhập
                </button>
            </form>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="DangKy" class="auth-link">Đăng ký</a>
                <a asp-action="QuenMatKhau" class="auth-link">Quên mật khẩu?</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}