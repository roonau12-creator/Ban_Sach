@model BanSach.Models.ViewModels.DatHangViewModel
@{
    ViewData["Title"] = "Đặt hàng";
}
<h2 class="fw-bold mb-4">Xác nhận đơn hàng</h2>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form asp-action="DatHang" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="MaDC" class="form-label fw-bold"></label>
                        <select asp-for="MaDC" class="form-select" asp-items="Model.DiaChis"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaSDT" class="form-label fw-bold"></label>
                        <select asp-for="MaSDT" class="form-select" asp-items="Model.SoDienThoais"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhuongThucThanhToan" class="form-label fw-bold"></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="PhuongThucThanhToan" value="@PhuongThucThanhToan.COD" id="cod" />
                            <label class="form-check-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="PhuongThucThanhToan" value="@PhuongThucThanhToan.ChuyenKhoan" id="ck" />
                            <label class="form-check-label" for="ck">Chuyển khoản (đánh dấu đã thanh toán)</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="GhiChu" class="form-label fw-bold"></label>
                        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaKhuyenMai" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="MaKhuyenMai" class="form-control" placeholder="Nhập mã khuyến mãi" />
                            <button class="btn btn-outline-primary" type="submit" name="hanhDong" value="ap-dung" formnovalidate>Áp dụng</button>
                        </div>
                        <span asp-validation-for="MaKhuyenMai" class="text-danger"></span>
                        @if (Model.GiamGia > 0)
                        {
                            <div class="form-text text-success">Mã @Model.MaKhuyenMai đã được áp dụng. Mỗi đơn hàng chỉ dùng một mã khuyến mãi.</div>
                        }
                    </div>
                    <button class="btn btn-dark btn-lg" type="submit" name="hanhDong" value="dat-hang">Xác nhận đặt hàng</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">Đơn hàng</div>
            <div class="card-body">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <div>@item.TenSach × @item.SoLuong</div>
                        <div>@HienThi.Tien(item.ThanhTien)</div>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Tạm tính:</span>
                    <span>@HienThi.Tien(Model.TongHang)</span>
                </div>
                @if (Model.GiamGia > 0)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>Giảm giá:</span>
                        <span>-@HienThi.Tien(Model.GiamGia)</span>
                    </div>
                }
                <div class="fw-bold">Tổng: @HienThi.Tien(Model.TongTien)</div>
            </div>
        </div>
    </div>
</div>
