@model BanSach.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}
<div class="hero-banner">
    <h1 class="display-5 fw-bold">BanSach</h1>
    <p class="lead mb-4">Chọn sách hay, giao tận tay. Tìm theo chủ đề, tác giả hoặc tên sách.</p>
    <form asp-area="Customer" asp-controller="Sach" asp-action="Index" method="get" class="d-flex gap-2" style="max-width:520px">
        <input class="form-control form-control-lg" name="q" placeholder="Bạn muốn đọc gì hôm nay?" />
        <button class="btn btn-light btn-lg">Tìm</button>
    </form>
</div>

<div class="mb-4">
    <h3 class="section-title">Chủ đề</h3>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var cd in Model.ChuDes)
        {
            <a class="btn btn-outline-secondary" asp-controller="Sach" asp-action="Index" asp-route-maCD="@cd.MaCD">@cd.TenChuDe</a>
        }
    </div>
</div>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <h3 class="section-title">Sách mới</h3>
        <a asp-controller="Sach" asp-action="Index">Xem tất cả</a>
    </div>
    <div class="row g-3">
        @foreach (var s in Model.SachMois)
        {
            <partial name="_SachCard" model="s" />
        }
    </div>
</section>

<section>
    <h3 class="section-title">Sách nổi bật</h3>
    <div class="row g-3">
        @foreach (var s in Model.SachNoiBats)
        {
            <partial name="_SachCard" model="s" />
        }
    </div>
</section>
