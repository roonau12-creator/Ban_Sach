@model IEnumerable<BanSach.Models.DiaChi>
@{
    ViewData["Title"] = "Địa chỉ";
}
<div class="row">
    <div class="col-md-3"><partial name="_AccountNav" /></div>
    <div class="col-md-9">
        <div class="d-flex justify-content-between mb-3">
            <h3 class="fw-bold">Địa chỉ</h3>
            <a asp-action="Create" class="btn btn-dark">Thêm địa chỉ</a>
        </div>
        @foreach (var d in Model)
        {
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        @d.DiaChiChiTiet
                        @if (d.MacDinh) { <span class="badge bg-secondary">Mặc định</span> }
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@d.MaDC" class="btn btn-sm btn-outline-secondary">Sửa</a>
                        <form asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@d.MaDC" />
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <p class="text-muted">Chưa có địa chỉ.</p>
        }
    </div>
</div>
