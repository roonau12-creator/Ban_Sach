@model BanSach.Models.DiaChi
@{
    ViewData["Title"] = "Thêm địa chỉ";
}
<div class="row">
    <div class="col-md-3"><partial name="_AccountNav" /></div>
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="fw-bold mb-3">Thêm địa chỉ</h3>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="DiaChiChiTiet" class="form-label"></label>
                        <input asp-for="DiaChiChiTiet" class="form-control" />
                        <span asp-validation-for="DiaChiChiTiet" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="MacDinh" class="form-check-input" />
                        <label asp-for="MacDinh" class="form-check-label"></label>
                    </div>
                    <button class="btn btn-dark">Lưu</button>
                    <a asp-action="Index" class="btn btn-link">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
