@model BanSach.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 1.75rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.25);
    }
    .page-header h2 { margin: 0; font-weight: 700; letter-spacing: .3px; }
    .page-header p  { margin: .25rem 0 0; opacity: .9; font-size: .95rem; }

    .stat-card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease;
        box-shadow: 0 4px 14px rgba(0,0,0,.06);
        position: relative;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0,0,0,.12);
    }
    .stat-card .card-body {
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .stat-icon {
        width: 56px; height: 56px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
        color: #fff;
        flex-shrink: 0;
    }
    .stat-icon.bg-1 { background: linear-gradient(135deg,#4facfe,#00f2fe); }
    .stat-icon.bg-2 { background: linear-gradient(135deg,#43e97b,#38f9d7); }
    .stat-icon.bg-3 { background: linear-gradient(135deg,#fa709a,#fee140); }
    .stat-icon.bg-4 { background: linear-gradient(135deg,#f093fb,#f5576c); }

    .stat-label { font-size: .82rem; color: #6c757d; text-transform: uppercase; letter-spacing: .5px; margin: 0; }
    .stat-value { font-size: 1.6rem; font-weight: 700; color: #212529; margin: .15rem 0 0; }

    .panel {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .panel .card-header {
        background: #fff;
        border-bottom: 1px solid #f1f3f5;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #343a40;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .panel .card-header i { color: #667eea; }

    .table-modern { margin: 0; }
    .table-modern thead th {
        background: #f8f9fc;
        color: #495057;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e9ecef;
        padding: .85rem 1rem;
    }
    .table-modern tbody td {
        padding: .9rem 1rem;
        vertical-align: middle;
        border-color: #f1f3f5;
        color: #495057;
    }
    .table-modern tbody tr { transition: background .15s ease; }
    .table-modern tbody tr:hover { background: #f8f9fc; }
    .table-modern a { color: #667eea; font-weight: 600; text-decoration: none; }
    .table-modern a:hover { text-decoration: underline; }

    .best-seller-list { list-style: none; padding: 0; margin: 0; }
    .best-seller-list li {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: .75rem .25rem;
        border-bottom: 1px dashed #edf0f5;
    }
    .best-seller-list li:last-child { border-bottom: none; }
    .rank {
        width: 32px; height: 32px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg,#667eea,#764ba2);
        flex-shrink: 0;
        font-size: .85rem;
    }
    .rank.top1 { background: linear-gradient(135deg,#f6d365,#fda085); }
    .rank.top2 { background: linear-gradient(135deg,#a8edea,#fed6e3); color:#495057; }
    .rank.top3 { background: linear-gradient(135deg,#d299c2,#fef9d7); color:#495057; }

    .seller-info { flex: 1; min-width: 0; }
    .seller-info .name { font-weight: 600; color: #212529; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .seller-info .meta { font-size: .82rem; color: #6c757d; }

    .empty-state {
        text-align: center;
        padding: 2rem 1rem;
        color: #adb5bd;
    }
    .empty-state i { font-size: 2rem; margin-bottom: .5rem; display: block; }
</style>

<!-- Header -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap">
    <div>
        <h2><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
        <p>Xin chào! Đây là tổng quan hoạt động của hệ thống.</p>
    </div>
    <div class="text-end">
        <div style="font-size:.9rem; opacity:.9;">Hôm nay</div>
        <div style="font-weight:600;">@DateTime.Now.ToString("dddd, dd/MM/yyyy")</div>
    </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon bg-1"><i class="bi bi-book"></i></div>
                <div>
                    <p class="stat-label">Tổng số sách</p>
                    <h3 class="stat-value">@Model.TongSach</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon bg-2"><i class="bi bi-people-fill"></i></div>
                <div>
                    <p class="stat-label">Tổng khách hàng</p>
                    <h3 class="stat-value">@Model.TongKhachHang</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon bg-3"><i class="bi bi-bag-check"></i></div>
                <div>
                    <p class="stat-label">Tổng đơn hàng</p>
                    <h3 class="stat-value">@Model.TongDonHang</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon bg-4"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <p class="stat-label">Doanh thu</p>
                    <h3 class="stat-value">@HienThi.Tien(Model.DoanhThu)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main panels -->
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card panel">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Đơn hàng mới
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-modern align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.DonHangMois != null && Model.DonHangMois.Any())
                        {
                            @foreach (var d in Model.DonHangMois)
                            {
                                <tr>
                                    <td><a asp-controller="DonHang" asp-action="Details" asp-route-id="@d.MaDH">#@d.MaDH</a></td>
                                    <td>@(d.KhachHang?.HoTen ?? "—")</td>
                                    <td>@d.NgayDat.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end fw-semibold">@HienThi.Tien(d.TongTien)</td>
                                    <td class="text-center">
                                        <span class="badge @HienThi.BadgeTrangThaiDon(d.TrangThai)">
                                            @HienThi.TrangThaiDon(d.TrangThai)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <div>Chưa có đơn hàng mới.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card panel">
            <div class="card-header">
                <i class="bi bi-trophy"></i> Sách bán chạy
            </div>
            <div class="card-body">
                @if (!Model.SachBanChays.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-bar-chart"></i>
                        <div>Chưa có dữ liệu.</div>
                    </div>
                }
                else
                {
                    <ul class="best-seller-list">
                        @{ int idx = 1; }
                        @foreach (var s in Model.SachBanChays)
                        {
                            string rankClass = idx == 1 ? "top1" : idx == 2 ? "top2" : idx == 3 ? "top3" : "";
                            <li>
                                <div class="rank @rankClass">@idx</div>
                                <div class="seller-info">
                                    <div class="name" title="@s.TenSach">@s.TenSach</div>
                                    <div class="meta">
                                        <i class="bi bi-box-seam"></i> @s.SoLuongBan cuốn
                                        <span class="mx-1">•</span>
                                        <i class="bi bi-cash-coin"></i> @HienThi.Tien(s.DoanhThu)
                                    </div>
                                </div>
                            </li>
                            idx++;
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>