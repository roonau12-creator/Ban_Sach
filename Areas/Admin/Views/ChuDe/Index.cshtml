@model IEnumerable<BanSach.Models.ChuDe>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Quản lý danh mục sách</h2>
            <p class="text-muted mb-0">Tạo và cập nhật danh mục dùng để phân loại sách.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm danh mục</a>
    </div>

    @if (TempData["success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px">Mã</th>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th style="width: 120px">Số sách</th>
                                <th style="width: 240px">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.MaCD</td>
                                    <td class="fw-semibold">@category.TenChuDe</td>
                                    <td>@(string.IsNullOrWhiteSpace(category.MoTa) ? "—" : category.MoTa)</td>
                                    <td>@category.Sachs.Count</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@category.MaCD" class="btn btn-info btn-sm text-white">Xem</a>
                                        <a asp-action="Edit" asp-route-id="@category.MaCD" class="btn btn-warning btn-sm">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@category.MaCD" class="btn btn-danger btn-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5>Chưa có danh mục nào</h5>
                    <a asp-action="Create" class="btn btn-primary mt-2">Thêm danh mục đầu tiên</a>
                </div>
            }
        </div>
    </div>
</div>
