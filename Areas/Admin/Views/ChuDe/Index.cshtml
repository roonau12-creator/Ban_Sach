@model IEnumerable<BanSach.Models.ChuDe>

@{
    ViewData["Title"] = "Quản lý chủ đề";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 1.75rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.25);
    }
    .page-header h2 { margin: 0; font-weight: 700; }
    .page-header p  { margin: .25rem 0 0; opacity: .9; font-size: .95rem; }
    .btn-add {
        background: #fff;
        color: #667eea;
        border: none;
        padding: .6rem 1.25rem;
        border-radius: .75rem;
        font-weight: 600;
        display: inline-flex; align-items: center; gap: .4rem;
        transition: transform .15s, box-shadow .15s;
        text-decoration: none;
    }
    .btn-add:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.15); color:#4c5fd1; }

    .search-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .search-card .card-body { padding: 1.25rem 1.5rem; }
    .search-input-wrap { position: relative; }
    .search-input-wrap i {
        position: absolute;
        left: 1rem; top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
    }
    .search-input-wrap input {
        padding-left: 2.75rem;
        border-radius: .75rem;
        border: 1px solid #e9ecef;
        height: 44px;
        transition: border-color .2s, box-shadow .2s;
    }
    .search-input-wrap input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }
    .btn-search {
        height: 44px;
        padding: 0 1.5rem;
        border-radius: .75rem;
        background: linear-gradient(135deg,#667eea,#764ba2);
        color: #fff; border: none; font-weight: 600;
        transition: transform .15s, box-shadow .15s;
    }
    .btn-search:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(102,126,234,.35); color:#fff; }
    .btn-reset {
        height: 44px;
        padding: 0 1rem;
        border-radius: .75rem;
        color: #6c757d;
    }

    .panel {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .panel .card-header {
        background: #fff;
        border-bottom: 1px solid #f1f3f5;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #343a40;
        display: flex; align-items: center; justify-content: space-between;
    }
    .panel .card-header i.title-icon { color: #667eea; margin-right: .5rem; }

    .table-modern { margin: 0; }
    .table-modern thead th {
        background: #f8f9fc;
        color: #495057;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e9ecef;
        padding: .85rem 1rem;
    }
    .table-modern tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-color: #f1f3f5;
        color: #495057;
    }
    .table-modern tbody tr { transition: background .15s ease; }
    .table-modern tbody tr:hover { background: #f8f9fc; }

    .topic-cell { display: flex; align-items: center; gap: .85rem; }
    .topic-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: inline-flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700;
        font-size: 1.1rem;
        flex-shrink: 0;
        text-transform: uppercase;
    }
    .topic-icon.bg-1 { background: linear-gradient(135deg,#4facfe,#00f2fe); }
    .topic-icon.bg-2 { background: linear-gradient(135deg,#43e97b,#38f9d7); }
    .topic-icon.bg-3 { background: linear-gradient(135deg,#fa709a,#fee140); }
    .topic-icon.bg-4 { background: linear-gradient(135deg,#f093fb,#f5576c); }
    .topic-icon.bg-5 { background: linear-gradient(135deg,#667eea,#764ba2); }
    .topic-icon.bg-6 { background: linear-gradient(135deg,#f6d365,#fda085); }

    .topic-info .name { font-weight: 600; color: #212529; }
    .topic-info .code { font-size: .78rem; color: #adb5bd; }

    .code-badge {
        display: inline-block;
        background: #eef1ff;
        color: #667eea;
        padding: .25rem .7rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
    }

    .action-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px;
        border-radius: .6rem;
        border: none;
        text-decoration: none;
        transition: transform .15s, box-shadow .15s;
        margin-left: .2rem;
    }
    .action-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,.1); }
    .action-view   { background: #eef1ff; color: #667eea; }
    .action-edit   { background: #fff7e6; color: #d35400; }
    .action-delete { background: #fdecec; color: #c0392b; }

    .empty-state {
        text-align: center;
        padding: 3.5rem 1rem;
        color: #adb5bd;
    }
    .empty-state i { font-size: 3rem; margin-bottom: .75rem; display: block; color: #ced4da; }
    .empty-state .title { color: #495057; font-weight: 600; margin-bottom: .25rem; font-size: 1.1rem; }
    .empty-state .desc  { color: #6c757d; margin-bottom: 1.25rem; }

    .count-badge {
        background: #eef1ff;
        color: #667eea;
        padding: .25rem .7rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }
</style>

<!-- Header -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-bookmark-star-fill me-2"></i>Quản lý chủ đề</h2>
        <p>Quản lý các chủ đề phân loại sách trong hệ thống.</p>
    </div>
    <a asp-area="Admin" asp-controller="ChuDe" asp-action="Create" class="btn-add">
        <i class="bi bi-plus-circle-fill"></i> Thêm chủ đề
    </a>
</div>

<!-- Search -->
<form method="get" class="search-card">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="search-input-wrap">
                    <i class="bi bi-search"></i>
                    <input name="q" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm tên chủ đề..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-search">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.TuKhoa as string))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-reset">
                        <i class="bi bi-x-circle"></i> Xóa lọc
                    </a>
                </div>
            }
        </div>
    </div>
</form>

<!-- Table -->
<div class="card panel">
    <div class="card-header">
        <div>
            <i class="bi bi-list-ul title-icon"></i> Danh sách chủ đề
        </div>
        <span class="count-badge">@Model.Count() chủ đề</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:120px">Mã chủ đề</th>
                            <th>Tên chủ đề</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int row = 0; }
                        @foreach (var item in Model)
                        {
                            var bgClass = "bg-" + ((row % 6) + 1);
                            var initial = string.IsNullOrEmpty(item.TenChuDe) ? "?" : item.TenChuDe.Trim().Substring(0, 1);
                            <tr>
                                <td>
                                    <span class="code-badge">#@item.MaCD</span>
                                </td>
                                <td>
                                    <div class="topic-cell">
                                        <div class="topic-icon @bgClass">@initial</div>
                                        <div class="topic-info">
                                            <div class="name">@item.TenChuDe</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-area="Admin" asp-controller="ChuDe" asp-action="Details" asp-route-id="@item.MaCD"
                                       class="action-btn action-view" title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="ChuDe" asp-action="Edit" asp-route-id="@item.MaCD"
                                       class="action-btn action-edit" title="Sửa">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="ChuDe" asp-action="Delete" asp-route-id="@item.MaCD"
                                       class="action-btn action-delete" title="Xóa">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                            row++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-folder2-open"></i>
                <div class="title">Chưa có chủ đề nào</div>
                <div class="desc">Thêm chủ đề đầu tiên để bắt đầu phân loại sách.</div>
                <a asp-area="Admin" asp-controller="ChuDe" asp-action="Create" class="btn btn-search">
                    <i class="bi bi-plus-circle me-1"></i> Thêm chủ đề mới
                </a>
            </div>
        }
    </div>
</div>