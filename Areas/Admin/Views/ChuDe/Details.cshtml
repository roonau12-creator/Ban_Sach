@model BanSach.Models.ChuDe

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Chi tiết danh mục sách</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Mã danh mục</dt>
                        <dd class="col-sm-9">@Model.MaCD</dd>
                        <dt class="col-sm-3">Tên danh mục</dt>
                        <dd class="col-sm-9">@Model.TenChuDe</dd>
                        <dt class="col-sm-3">Mô tả</dt>
                        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "—" : Model.MoTa)</dd>
                    </dl>

                    <h5 class="mt-4">Sách thuộc danh mục (@Model.Sachs.Count)</h5>
                    @if (Model.Sachs.Count == 0)
                    {
                        <p class="text-muted">Chưa có sách trong danh mục này.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var book in Model.Sachs.OrderBy(book => book.TenSach))
                            {
                                <li>@book.TenSach</li>
                            }
                        </ul>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <a asp-action="Edit" asp-route-id="@Model.MaCD" class="btn btn-warning">Sửa danh mục</a>
                </div>
            </div>
        </div>
    </div>
</div>
