@model BanSach.Models.NhaXuatBan
@{
    ViewData["Title"] = "Xóa nhà xuất bản";
}
<div class="card border-danger shadow-sm col-lg-7">
    <div class="card-header bg-danger text-white"><h4 class="mb-0">Xóa nhà xuất bản</h4></div>
    <div class="card-body">
        <p>Xóa <strong>@Model.TenNXB</strong>?</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaNXB" />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                <button class="btn btn-danger">Xác nhận xóa</button>
            </div>
        </form>
    </div>
</div>
