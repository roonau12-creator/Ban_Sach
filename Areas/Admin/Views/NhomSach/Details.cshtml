@model BanSach.Models.NhomSach
@{
    ViewData["Title"] = "Chi tiết nhóm sách";
}
<div class="card shadow-sm col-lg-8">
    <div class="card-header bg-info text-white"><h4 class="mb-0">Chi tiết nhóm sách</h4></div>
    <div class="card-body">
        <p><strong>Tên nhóm:</strong> @Model.TenNhom</p>
        <p><strong>Trạng thái:</strong> @(Model.TrangThai ? "Đang bật" : "Đã tắt")</p>
        <p><strong>Thứ tự:</strong> @Model.ThuTu</p>
        <p><strong>Mô tả:</strong> @(Model.MoTa ?? "—")</p>
        <hr />
        <h5>Sách trong nhóm</h5>
        @if (Model.Sachs.Any())
        {
            <ul>
                @foreach (var s in Model.Sachs)
                {
                    <li>@s.TenSach</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Chưa có sách.</p>
        }
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        <a asp-action="Edit" asp-route-id="@Model.MaNhom" class="btn btn-warning">Sửa</a>
    </div>
</div>
