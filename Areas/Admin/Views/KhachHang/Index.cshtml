@model IEnumerable<BanSach.Models.KhachHang>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-people"></i> Khách hàng</h2>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm tên, email, tài khoản..." /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Tìm</button></div>
</form>
<div class="card shadow-sm">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Họ tên</th><th>Tài khoản</th><th>Email</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.HoTen</td>
                    <td>@item.TaiKhoan?.TenDangNhap</td>
                    <td>@item.TaiKhoan?.Email</td>
                    <td>
                        <form asp-action="BatTat" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.MaKH" />
                            <button class="btn btn-sm @(item.TaiKhoan?.TrangThai == true ? "btn-success" : "btn-outline-secondary")">
                                @(item.TaiKhoan?.TrangThai == true ? "Hoạt động" : "Đã khóa")
                            </button>
                        </form>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.MaKH" class="btn btn-info btn-sm text-white">Chi tiết</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
