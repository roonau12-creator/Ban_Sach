@model IEnumerable<BanSach.Models.DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 1.75rem 2rem;
        border-radius: 1rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.25);
    }
    .page-header h2 { margin: 0; font-weight: 700; }
    .page-header p  { margin: .25rem 0 0; opacity: .9; font-size: .95rem; }

    .filter-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }
    .filter-card .card-body { padding: 1.25rem 1.5rem; }
    .filter-card .form-select {
        border-radius: .75rem;
        border: 1px solid #e9ecef;
        height: 44px;
        transition: border-color .2s, box-shadow .2s;
        padding-left: 2.75rem;
        background-position: right 1rem center;
    }
    .filter-card .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }
    .select-wrap { position: relative; }
    .select-wrap i {
        position: absolute;
        left: 1rem; top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        z-index: 2;
        pointer-events: none;
    }
    .btn-filter {
        height: 44px;
        padding: 0 1.5rem;
        border-radius: .75rem;
        background: linear-gradient(135deg,#667eea,#764ba2);
        color: #fff; border: none; font-weight: 600;
        transition: transform .15s, box-shadow .15s;
    }
    .btn-filter:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(102,126,234,.35); color:#fff; }
    .btn-reset {
        height: 44px;
        padding: 0 1rem;
        border-radius: .75rem;
        color: #6c757d;
    }

    .panel {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        overflow: hidden;
    }
    .panel .card-header {
        background: #fff;
        border-bottom: 1px solid #f1f3f5;
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #343a40;
        display: flex; align-items: center; justify-content: space-between;
    }
    .panel .card-header i.title-icon { color: #667eea; margin-right: .5rem; }

    .table-modern { margin: 0; }
    .table-modern thead th {
        background: #f8f9fc;
        color: #495057;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e9ecef;
        padding: .85rem 1rem;
        white-space: nowrap;
    }
    .table-modern tbody td {
        padding: 1rem;
        vertical-align: middle;
        border-color: #f1f3f5;
        color: #495057;
    }
    .table-modern tbody tr { transition: background .15s ease; }
    .table-modern tbody tr:hover { background: #f8f9fc; }

    .order-code {
        display: inline-block;
        background: #eef1ff;
        color: #667eea;
        padding: .3rem .75rem;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 700;
    }

    .customer-cell { display: flex; align-items: center; gap: .75rem; }
    .customer-avatar {
        width: 38px; height: 38px;
        border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700;
        font-size: .9rem;
        flex-shrink: 0;
        background: linear-gradient(135deg,#667eea,#764ba2);
        text-transform: uppercase;
    }
    .customer-info .name { font-weight: 600; color: #212529; }
    .customer-info .sub  { font-size: .78rem; color: #adb5bd; }

    .date-cell .date { font-weight: 500; color: #212529; }
    .date-cell .time { font-size: .78rem; color: #adb5bd; }

    .price { font-weight: 700; color: #f5576c; white-space: nowrap; }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .85rem;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .status-pill i { font-size: .75rem; }
    .status-cho      { background: #fff7e6; color: #d35400; }
    .status-xacnhan  { background: #e7f1ff; color: #1e6fd6; }
    .status-danggiao { background: #f3e8ff; color: #7c3aed; }
    .status-dagiao   { background: #e6f9ee; color: #0d8a3f; }
    .status-dahuy    { background: #f1f3f5; color: #6c757d; }

    .pay-paid   { color: #0d8a3f; font-weight: 600; }
    .pay-unpaid { color: #c0392b; font-weight: 600; }

    .btn-detail {
        background: #eef1ff;
        color: #667eea;
        border: none;
        padding: .45rem 1rem;
        border-radius: .6rem;
        font-weight: 600;
        font-size: .85rem;
        text-decoration: none;
        display: inline-flex; align-items: center; gap: .35rem;
        transition: background .15s;
    }
    .btn-detail:hover { background: #dde3ff; color: #4c5fd1; }

    .empty-state {
        text-align: center;
        padding: 3.5rem 1rem;
        color: #adb5bd;
    }
    .empty-state i { font-size: 3rem; margin-bottom: .75rem; display: block; color: #ced4da; }
    .empty-state .title { color: #495057; font-weight: 600; margin-bottom: .25rem; font-size: 1.1rem; }

    .count-badge {
        background: #eef1ff;
        color: #667eea;
        padding: .25rem .7rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }
</style>

<!-- Header -->
<div class="page-header">
    <h2><i class="bi bi-receipt-cutoff me-2"></i>Quản lý đơn hàng</h2>
    <p>Theo dõi và xử lý các đơn hàng từ khách hàng.</p>
</div>

<!-- Filter -->
<form method="get" class="filter-card">
    <div class="card-body">
        @{
            var trangThaiHienTai = ViewBag.TrangThai as string;
        }
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="select-wrap">
                    <i class="bi bi-funnel-fill"></i>
                    <select name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="@TrangThaiDonHang.ChoXacNhan" selected="@(trangThaiHienTai == TrangThaiDonHang.ChoXacNhan.ToString())">Chờ xác nhận</option>
                        <option value="@TrangThaiDonHang.DaXacNhan" selected="@(trangThaiHienTai == TrangThaiDonHang.DaXacNhan.ToString())">Đã xác nhận</option>
                        <option value="@TrangThaiDonHang.DangGiao" selected="@(trangThaiHienTai == TrangThaiDonHang.DangGiao.ToString())">Đang giao</option>
                        <option value="@TrangThaiDonHang.DaGiao" selected="@(trangThaiHienTai == TrangThaiDonHang.DaGiao.ToString())">Đã giao</option>
                        <option value="@TrangThaiDonHang.DaHuy" selected="@(trangThaiHienTai == TrangThaiDonHang.DaHuy.ToString())">Đã hủy</option>
                    </select>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-filter">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc
                </button>
            </div>
            @if (!string.IsNullOrEmpty(trangThaiHienTai))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-reset">
                        <i class="bi bi-x-circle"></i> Xóa lọc
                    </a>
                </div>
            }
        </div>
    </div>
</form>

<!-- Table -->
<div class="card panel">
    <div class="card-header">
        <div>
            <i class="bi bi-list-ul title-icon"></i> Danh sách đơn hàng
        </div>
        <span class="count-badge">@Model.Count() đơn</span>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thanh toán</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            var initial = string.IsNullOrEmpty(d.KhachHang?.HoTen) ? "?" : d.KhachHang.HoTen.Trim().Substring(0, 1);
                            var statusClass = d.TrangThai == TrangThaiDonHang.ChoXacNhan ? "status-cho"
                                            : d.TrangThai == TrangThaiDonHang.DaXacNhan ? "status-xacnhan"
                                            : d.TrangThai == TrangThaiDonHang.DangGiao ? "status-danggiao"
                                            : d.TrangThai == TrangThaiDonHang.DaGiao ? "status-dagiao"
                                            : "status-dahuy";
                            var statusIcon = d.TrangThai == TrangThaiDonHang.ChoXacNhan ? "bi-hourglass-split"
                                           : d.TrangThai == TrangThaiDonHang.DaXacNhan ? "bi-check2-circle"
                                           : d.TrangThai == TrangThaiDonHang.DangGiao ? "bi-truck"
                                           : d.TrangThai == TrangThaiDonHang.DaGiao ? "bi-check-circle-fill"
                                           : "bi-x-circle-fill";
                            var ngay = d.NgayDat.ToLocalTime();
                            var ttThanhToan = HienThi.ThanhToan(d.TrangThaiThanhToan);
                            var isPaid = ttThanhToan.Contains("Đã") || ttThanhToan.Contains("Thành công");
                            <tr>
                                <td>
                                    <span class="order-code">#@d.MaDH</span>
                                </td>
                                <td>
                                    <div class="customer-cell">
                                        <div class="customer-avatar">@initial</div>
                                        <div class="customer-info">
                                            <div class="name">@(d.KhachHang?.HoTen ?? "—")</div>
                                            <div class="sub">Mã KH: @(d.KhachHang?.MaKH.ToString() ?? "—")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="date-cell">
                                        <div class="date">@ngay.ToString("dd/MM/yyyy")</div>
                                        <div class="time">@ngay.ToString("HH:mm")</div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span class="price">@HienThi.Tien(d.TongTien)</span>
                                </td>
                                <td class="text-center">
                                    <span class="status-pill @statusClass">
                                        <i class="bi @statusIcon"></i>
                                        @HienThi.TrangThaiDon(d.TrangThai)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (isPaid)
                                    {
                                        <span class="pay-paid">
                                            <i class="bi bi-check-circle-fill me-1"></i>@ttThanhToan
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pay-unpaid">
                                            <i class="bi bi-clock-fill me-1"></i>@ttThanhToan
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@d.MaDH" class="btn-detail">
                                        <i class="bi bi-eye-fill"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <div class="title">Chưa có đơn hàng nào</div>
                <div>Thay đổi bộ lọc để tìm kiếm đơn hàng.</div>
            </div>
        }
    </div>
</div>