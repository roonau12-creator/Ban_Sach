@model BanSach.Models.TacGia
@{
    ViewData["Title"] = "Chi tiết tác giả";
}
<div class="card shadow-sm col-lg-8">
    <div class="card-header bg-info text-white"><h4 class="mb-0">Chi tiết tác giả</h4></div>
    <div class="card-body">
        <p><strong>Tên:</strong> @Model.TenTacGia</p>
        <p><strong>Tiểu sử:</strong></p>
        <p>@(string.IsNullOrWhiteSpace(Model.TieuSu) ? "—" : Model.TieuSu)</p>
        <hr />
        <h5>Sách đã gán</h5>
        @if (Model.SachTacGias.Any())
        {
            <ul>
                @foreach (var st in Model.SachTacGias)
                {
                    <li>@st.Sach?.TenSach</li>
                }
            </ul>
        }
        else { <p class="text-muted">Chưa gán sách.</p> }
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        <a asp-action="Edit" asp-route-id="@Model.MaTG" class="btn btn-warning">Sửa</a>
    </div>
</div>
