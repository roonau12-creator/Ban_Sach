@model IEnumerable<BanSach.Models.TacGia>
@{
    ViewData["Title"] = "Quản lý tác giả";
}

<style>
    /* Custom CSS cho giao diện */
    .avatar-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .table > :not(caption) > * > * {
        padding: 1.1rem 0.75rem; /* Tăng chiều cao dòng cho dễ đọc */
    }
    .table-hover tbody tr:hover {
        background-color: rgba(var(--bs-primary-rgb), 0.04); /* Hover màu xanh rất nhạt */
    }
    .btn-action-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.2s;
    }
    .btn-action-icon:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
</style>

<!-- 1. Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pen-fill text-primary me-2"></i>Quản lý Tác giả
        </h2>
        <p class="text-muted mb-0 small">Danh sách các tác giả và thông tin tiểu sử</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
        <i class="bi bi-plus-lg me-1"></i> Thêm tác giả
    </a>
</div>

<!-- 2. Thanh tìm kiếm -->
<div class="card border-0 bg-light shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input name="q" value="@ViewBag.TuKhoa" class="form-control border-start-0 ps-0" placeholder="Nhập tên tác giả cần tìm..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.TuKhoa))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-x-lg me-1"></i> Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- 3. Bảng dữ liệu -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4 border-0" style="width: 35%;">Tác giả</th>
                        <th class="border-0">Tiểu sử</th>
                        <th class="text-center border-0" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        // Lấy chữ cái đầu tiên làm Avatar
                        var initial = !string.IsNullOrEmpty(item.TenTacGia) ? item.TenTacGia[0].ToString().ToUpper() : "?";
                        
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary fw-bold me-3">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.TenTacGia</div>
                                        <small class="text-muted">Mã: @item.MaTG</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <!-- Thêm title để hover vào sẽ thấy toàn bộ nội dung khi bị cắt -->
                                <span class="text-truncate d-block text-muted" style="max-width: 450px;" title="@item.TieuSu">
                                    @item.TieuSu
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.MaTG" 
                                       class="btn btn-outline-info btn-action-icon" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MaTG" 
                                       class="btn btn-outline-warning btn-action-icon" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaTG" 
                                       class="btn btn-outline-danger btn-action-icon" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <!-- Giao diện khi không có dữ liệu -->
                    <tr>
                        <td colspan="3" class="text-center py-5 bg-white">
                            <i class="bi bi-inbox display-3 text-muted opacity-50"></i>
                            <p class="text-muted mt-3 mb-0">Không tìm thấy tác giả nào.</p>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>