@model IEnumerable<BanSach.Models.KhuyenMai>
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Chương trình khuyến mãi</h2>
        <p class="text-muted mb-0">Quản lý mã giảm giá và điều kiện áp dụng.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Tạo chương trình</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Chương trình</th>
                    <th>Mức giảm</th>
                    <th>Đơn tối thiểu</th>
                    <th>Thời gian (UTC)</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var mucGiam = item.LoaiGiamGia == LoaiGiamGiaKhuyenMai.PhanTram
                        ? $"{item.GiaTriGiam:N2}%"
                        : HienThi.Tien(item.GiaTriGiam);
                    <tr>
                        <td><span class="badge text-bg-light">@item.MaCode</span></td>
                        <td>@item.TenKhuyenMai</td>
                        <td>
                            @mucGiam
                            @if (item.GiamToiDa.HasValue)
                            {
                                <span class="text-muted d-block">Tối đa @HienThi.Tien(item.GiamToiDa.Value)</span>
                            }
                        </td>
                        <td>@HienThi.Tien(item.DonHangToiThieu)</td>
                        <td>
                            @item.NgayBatDau.ToString("dd/MM/yyyy HH:mm")
                            <span class="text-muted">—</span>
                            @item.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <span class="badge @(item.DangHoatDong ? "text-bg-success" : "text-bg-secondary")">
                                @(item.DangHoatDong ? "Đang hoạt động" : "Đã tắt")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.MaKM" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DoiTrangThai" asp-route-id="@item.MaKM" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(item.DangHoatDong ? "Tắt" : "Bật")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có chương trình khuyến mãi.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
